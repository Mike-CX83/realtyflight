# Saved settings for phone_demo.sh — sourced automatically if present.
# Lives at drone-mission/.phone_demo.env (this data is public; safe to commit).
#
# Tulsa County parcels (INCOG public FeatureServer, found D13). Every phone
# demo gets REAL lot boundaries from this without anyone remembering the env var.
DASH_PARCEL_URL="https://map11.incog.org/arcgis11wa/rest/services/Parcels_TulsaCo/FeatureServer/0"

# Optional overrides:
# DASH_PORT=8000
# DASH_MODEL=scripted     # force scripted planning even without --scripted
